{
  "name": "th-m",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run generate:brand && vite",
    "graph": "vite --open /graph.html",
    "build:graph": "tsc -b && vite build --config vite.graph.config.ts",
    "calibrate:brand:m": "bun run scripts/brand/calibrate-m.ts",
    "score:brand:m": "bun run scripts/brand/score-m-candidates.ts",
    "generate:brand": "bun run scripts/brand/generate-brand.ts",
    "generate:brand:h-phi": "bun run scripts/brand/hPhiAsset.ts",
    "generate:brand:t": "bun run scripts/brand/generate-t.ts",
    "measure:brand:balance": "bun run scripts/brand/measure-logo-balance.ts",
    "check:brand:balance": "bun run scripts/brand/check-logo-balance.ts",
    "score:brand:balance": "bun run scripts/brand/build-logo-balance-scorecard.ts",
    "build": "bun run generate:brand && tsc -b && vite build && bun run scripts/prerender.tsx",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:graph:e2e": "playwright test --config playwright.graph.config.ts",
    "test:e2e": "playwright test --project=desktop --project=mobile",
    "audit:brand": "bun run build && bun run scripts/visual/prepare-brand-reference.ts && playwright test tests/visual/brand-compare.spec.ts --project=brand-audit && bun run scripts/visual/compose-brand-qa.ts",
    "audit:brand:update": "bun run build && bun run scripts/visual/prepare-brand-reference.ts && playwright test tests/visual/brand-compare.spec.ts --project=brand-audit --update-snapshots && bun run scripts/visual/compose-brand-qa.ts",
    "check": "bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "latest",
    "@fontsource-variable/newsreader": "latest",
    "@fontsource/ibm-plex-mono": "latest",
    "@xyflow/react": "^12.11.3",
    "elkjs": "^0.12.0",
    "motion": "latest",
    "react": "latest",
    "react-dom": "latest",
    "three": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@playwright/test": "latest",
    "@resvg/resvg-js": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/bun": "latest",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "latest",
    "@vitejs/plugin-react": "latest",
    "jsdom": "latest",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.3",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
