{
  "name": "th-m-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "libs/*", "tools/*"],
  "scripts": {
    "nx": "nx",
    "typecheck": "bun run nx run-many -t typecheck",
    "test": "bun run nx run-many -t test",
    "publish": "bun run nx run-many -t publish --projects=blogs,portfolio",
    "check": "bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@nx/js": "23.1.0",
    "@types/bun": "1.3.14",
    "nx": "23.1.0",
    "typescript": "6.0.2",
    "vitest": "latest"
  },
  "packageManager": "bun@1.3.14",
  "engines": { "bun": ">=1.3.14" }
}
