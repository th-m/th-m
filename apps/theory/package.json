{
  "name": "@th-m/theory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 5193 --strictPort",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test": "vitest run --config vite.config.ts",
    "publish": "vite build"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.0",
    "vite": "8.2.2",
    "typescript": "6.0.2",
    "vitest": "4.1.11",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@testing-library/react": "16.3.2",
    "@testing-library/jest-dom": "7.0.1",
    "@th-m/testing": "workspace:*",
    "jsdom": "30.0.1"
  },
  "nx": {
    "name": "theory",
    "sourceRoot": "apps/theory/src",
    "projectType": "application",
    "tags": [
      "kind:app",
      "runtime:web",
      "domain:music"
    ],
    "targets": {
      "start": {
        "outputs": []
      },
      "typecheck": {
        "outputs": []
      },
      "test": {
        "outputs": []
      },
      "publish": {
        "outputs": [
          "{projectRoot}/dist"
        ]
      }
    }
  }
}
