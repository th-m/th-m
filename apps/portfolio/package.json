{
  "name": "@th-m/portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "bun run generate:brand && bun run prepare:content && vite --port 5173",
    "publish": "bun run generate:brand && bun run prepare:content && bun run typecheck && vite build && bun run verify:publish",
    "prepare:content": "bun run scripts/prepare-content.ts",
    "generate:routes": "tsr generate",
    "verify:publish": "bun run scripts/verify-static-build.ts",
    "calibrate:brand:m": "bun run scripts/brand/calibrate-m.ts",
    "compose:brand:stroke-energy": "bun run scripts/brand/compose-stroke-energy-evidence.ts",
    "score:brand:m": "bun run scripts/brand/score-m-candidates.ts",
    "generate:brand": "bun run --cwd ../../libs/thom-brand gen && bun run scripts/brand/generate-brand.ts",
    "generate:brand:t": "bun run --cwd ../../libs/thom-brand gen && bun run scripts/brand/generate-t.ts",
    "measure:brand:balance": "bun run scripts/brand/measure-logo-balance.ts",
    "check:brand:balance": "bun run scripts/brand/check-logo-balance.ts",
    "score:brand:balance": "bun run scripts/brand/build-logo-balance-scorecard.ts",
    "measure:brand:source-energy": "bun run scripts/brand/measure-source-energy.ts",
    "preview": "vite preview",
    "typecheck": "bun run prepare:content && bun run generate:routes && tsc -b tsconfig.app.json tsconfig.node.json --pretty false",
    "test": "bun run prepare:content && vitest run --config vite.config.ts",
    "test:watch": "vitest",
    "e2e": "playwright test --config playwright.config.ts --project=desktop --project=mobile",
    "audit": "bun run publish && bun run scripts/visual/prepare-brand-reference.ts && playwright test --config playwright.config.ts --project=brand-audit && bun run scripts/visual/compose-brand-qa.ts",
    "audit:update": "bun run publish && bun run scripts/visual/prepare-brand-reference.ts && playwright test --config playwright.config.ts --project=brand-audit --update-snapshots && bun run scripts/visual/compose-brand-qa.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "latest",
    "@fontsource-variable/newsreader": "latest",
    "@fontsource/ibm-plex-mono": "latest",
    "@tanstack/react-router": "1.170.29",
    "@tanstack/react-start": "1.168.46",
    "@th-m/blogs": "workspace:*",
    "@th-m/design-theme": "workspace:*",
    "@th-m/embedding-space": "workspace:*",
    "@th-m/llm-decoding": "workspace:*",
    "@th-m/llm-generation": "workspace:*",
    "@th-m/llm-training": "workspace:*",
    "@th-m/llm-visualization": "workspace:*",
    "@th-m/thom-brand": "workspace:*",
    "@th-m/ui": "workspace:*",
    "motion": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "latest",
    "rehype-slug": "latest",
    "remark-gfm": "latest",
    "three": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@th-m/testing": "workspace:*",
    "@axe-core/playwright": "latest",
    "@playwright/test": "latest",
    "@resvg/resvg-js": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@tanstack/router-cli": "1.167.30",
    "@types/bun": "latest",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "latest",
    "@vitejs/plugin-react": "latest",
    "jsdom": "latest",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "playwright": "latest",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.0",
    "typescript": "6.0.2",
    "vite": "latest",
    "vitest": "latest"
  },
  "nx": {
    "name": "portfolio",
    "sourceRoot": "apps/portfolio/src",
    "projectType": "application",
    "tags": ["kind:app", "runtime:web", "domain:portfolio"],
    "targets": {
      "publish": { "outputs": ["{projectRoot}/dist"] },
      "typecheck": { "outputs": [] },
      "test": { "outputs": [] },
      "start": { "outputs": [] },
      "e2e": { "outputs": [] },
      "audit": { "outputs": [] }
    }
  }
}
