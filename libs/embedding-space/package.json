{
  "name": "@th-m/embedding-space",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./composition": "./src/composition.ts",
    "./training": "./src/training.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "gen": "bun run scripts/generate-gpt2-dataset.ts",
    "gen-training": "bun run scripts/generate-training-checkpoints.ts",
    "gen-composition-review": "bun run scripts/generate-composition-review-csv.ts",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "@th-m/design-theme": "workspace:*",
    "react": "latest",
    "react-dom": "latest",
    "three": "latest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@th-m/testing": "workspace:*",
    "@types/bun": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "latest",
    "jsdom": "latest",
    "typescript": "6.0.2",
    "vitest": "latest"
  },
  "nx": {
    "name": "embedding-space",
    "sourceRoot": "libs/embedding-space/src",
    "projectType": "library",
    "tags": ["kind:lib", "runtime:web", "domain:visualization"],
    "targets": {
      "gen": { "outputs": ["{projectRoot}/src/data/gpt2-embedding-space.json"] },
      "gen-training": { "outputs": ["{projectRoot}/src/data/skip-gram-training.json"] },
      "gen-composition-review": { "outputs": ["{projectRoot}/generated/embedding-composition-review.csv"] },
      "typecheck": { "outputs": [] },
      "test": { "outputs": [] }
    }
  }
}
