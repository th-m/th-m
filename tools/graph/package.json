{
  "name": "@th-m/graph",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 5190 --strictPort --open /",
    "gen": "bun run src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test": "vitest run --config vite.config.ts",
    "e2e": "playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "latest",
    "@fontsource/ibm-plex-mono": "latest",
    "@th-m/design-theme": "workspace:*",
    "@th-m/graph-visualization": "workspace:*",
    "elkjs": "^0.12.0",
    "react": "latest",
    "react-dom": "latest",
    "web-worker": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@tailwindcss/vite": "^4.3.0",
    "@playwright/test": "latest",
    "@resvg/resvg-js": "latest",
    "@th-m/testing": "workspace:*",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/bun": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "tailwindcss": "^4.3.0",
    "typescript": "6.0.2",
    "vite": "latest",
    "vitest": "latest"
  },
  "nx": {
    "name": "graph",
    "sourceRoot": "tools/graph/src",
    "projectType": "application",
    "tags": ["kind:tool", "runtime:web", "domain:graph"],
    "targets": {
      "start": { "outputs": [] },
      "gen": { "outputs": [] },
      "typecheck": { "outputs": [] },
      "test": { "outputs": [] },
      "e2e": { "outputs": [] }
    }
  }
}
