{
  "name": "@th-m/diagrams",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/cli.ts preview",
    "setup": "bun run src/cli.ts setup",
    "gen": "bun run src/cli.ts gen",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@th-m/diagram-theme": "workspace:*",
    "@fontsource-variable/inter": "latest",
    "@fontsource-variable/newsreader": "latest",
    "@fontsource/ibm-plex-mono": "latest",
    "playwright": "1.62.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "6.0.2",
    "vitest": "4.1.11"
  },
  "nx": {
    "name": "diagrams",
    "sourceRoot": "tools/diagrams/src",
    "projectType": "application",
    "tags": [
      "kind:tool",
      "runtime:node",
      "domain:diagrams"
    ],
    "targets": {
      "setup": {
        "cache": false,
        "outputs": []
      },
      "gen": {
        "outputs": []
      },
      "typecheck": {
        "outputs": []
      },
      "test": {
        "outputs": []
      }
    }
  }
}
